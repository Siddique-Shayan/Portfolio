# Copy this file to .env for local development with `vercel dev`.
# In production, set these in the Vercel dashboard: Project Settings → Environment Variables.
# Never commit the real .env file.

# SMTP credentials used by api/contact.ts to send contact-form emails via nodemailer.
# Works with any SMTP provider (Gmail, Outlook, SendGrid, Mailgun, Zoho, etc.)
# For Gmail: host=smtp.gmail.com, port=465, secure=true, and use an App Password
# (not your normal password) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Inbox that receives contact-form submissions. Defaults to SMTP_USER if omitted.
CONTACT_TO_EMAIL=shayanmohd463@gmail.com

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX), from
# analytics.google.com → Admin → Data Streams → your web stream.
# Only loaded in production builds (see src/utils/analytics.ts).
VITE_GA_MEASUREMENT_ID=
